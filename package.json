  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@types/jsdom": "^30.0.0",
    "astro": "^7.4.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
